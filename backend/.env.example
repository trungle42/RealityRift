GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=12000
# OFFLINE=1 forces fallbacks (demo insurance when venue Wi-Fi dies)
OFFLINE=0
CORS_ORIGINS=http://localhost:5173
# The webcam relay (/ws/cv) only accepts this laptop. CV_ALLOW_REMOTE=1 lets other machines on the network join it (and see the camera).
# CV_ALLOW_REMOTE=1
